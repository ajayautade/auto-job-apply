# ==============================================
# Auto Job Apply AI - Environment Configuration
# ==============================================

# Google Gemini API Key
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP Configuration
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Candidate Profile Details (Used for email & WhatsApp generation)
YOUR_NAME=Your Full Name
YOUR_TITLE=DevOps Engineer | Cloud & Platform Specialist
YOUR_EMAIL=your_email@gmail.com
YOUR_PHONE=+1 234 567 8900
YOUR_PORTFOLIO=https://yourportfolio.com
YOUR_LINKEDIN=https://linkedin.com/in/yourprofile
YOUR_GITHUB=https://github.com/yourusername

# Custom Email Signature Block (\n for newlines)
EMAIL_SIGNATURE=Your Name\nYour Title\nP: +1 234 567 8900\nE: your_email@gmail.com\nW: yourportfolio.com | In: linkedin.com/in/yourprofile

# Auto-Pilot Watch Folder (Relative or Absolute path)
WATCH_FOLDER=./auto_jobs

# Outbound Throttling & Daily Quotas (Protects Gmail Sender Reputation)
DAILY_SEND_LIMIT=150
MIN_JITTER_SECONDS=15
MAX_JITTER_SECONDS=35

# Automated Follow-Up Cadence (Days after initial application)
FOLLOW_UP_DAYS=4

# Server Configuration
PORT=3000
