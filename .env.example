# ==============================================
# Auto Job Apply AI - Environment Configuration
# ==============================================

# Google Gemini API Key
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP Configuration
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Candidate Profile Details (Used for email & WhatsApp generation)
YOUR_NAME=Er. Ajay Autade
YOUR_TITLE=DevOps Engineer | Computer Science Engineer
YOUR_EMAIL=your_email@gmail.com
YOUR_PHONE=+91 9545034120
YOUR_PORTFOLIO=https://ajayautade.com
YOUR_LINKEDIN=https://linkedin.com/in/ajayautadepatil
YOUR_GITHUB=https://github.com/ajayautade

# Custom Email Signature Block (\n for newlines)
EMAIL_SIGNATURE=Er. Ajay Autade\nDevOps Engineer | Computer Science Engineer\nP: +91 9545034120 | +91 7820902571\nE: your_email@gmail.com\nW: ajayautade.com | In: linkedin.com/in/ajayautadepatil

# Auto-Pilot Watch Folder (Relative or Absolute path)
WATCH_FOLDER=./auto_jobs

# Outbound Throttling & Daily Quotas (Protects Gmail Sender Reputation)
DAILY_SEND_LIMIT=150
MIN_JITTER_SECONDS=15
MAX_JITTER_SECONDS=35

# Automated Follow-Up Cadence (Days after initial application)
FOLLOW_UP_DAYS=4

# Server Configuration
PORT=3000
